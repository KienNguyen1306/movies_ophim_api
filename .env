# =====================================================================
# Biến môi trường CineTube
# Sao chép file này thành .env.local và điền giá trị thực
# KHÔNG commit .env.local lên git
# =====================================================================

# URL API gốc — chỉ tồn tại server-side, không bao giờ lộ ra client
OPHIM_ORIGIN=https://ophim1.com

# Khóa bí mật AES-GCM dùng để mã hóa response API phim
CRYPTO_SECRET=thay_bang_chuoi_ngau_nhien_cua_ban_toi_thieu_32_ky_tu

# Khóa phía client (phải KHỚP với CRYPTO_SECRET)
NEXT_PUBLIC_CRYPTO_KEY=thay_bang_chuoi_ngau_nhien_cua_ban_toi_thieu_32_ky_tu

# ─── MySQL ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=api_ophim_movie_system

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Chuỗi bí mật để ký JWT session (>= 32 ký tự, giữ bí mật tuyệt đối)
JWT_SECRET=thay_bang_chuoi_bi_mat_jwt_cua_ban_toi_thieu_32_ky_tu
